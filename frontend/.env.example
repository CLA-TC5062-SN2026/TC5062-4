# ---------------------------------------------------------------------------
# Configuración del frontend de DAFI
# Copie este archivo a .env.local y ajuste los valores. .env.local no se versiona.
# ---------------------------------------------------------------------------

# Ruta base del API tal como la ve el NAVEGADOR.
# Es relativa a propósito: Next.js reescribe /api/v1/* hacia el backend de
# Express (ver rewrites en next.config.ts), así que cliente y API comparten
# origen y no hay peticiones de origen cruzado.
# El prefijo NEXT_PUBLIC_ expone la variable al navegador: nunca ponga
# secretos en una variable con ese prefijo, acaban dentro del bundle.
NEXT_PUBLIC_API_URL=/api/v1

# Dirección real del backend de Express (S05-S06-A2). Sólo la usa el servidor
# de Next al reescribir; el navegador no la ve.
BACKEND_URL=http://localhost:4000

# Nombre de la app mostrado en la barra de navegación.
NEXT_PUBLIC_APP_NAME=DAFI
